<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- final 3.3 patch release; supported-platform migration (3.5 / 4.x) is a separate workstream -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>com.tazzzo</groupId>
    <artifactId>catalog-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Tazzzo Catalog Service</name>
    <description>Catalogue backend implementing Implementation Contract V1 (T1-T7, write path, schema bootstrap)</description>
    <properties>
        <java.version>21</java.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <!--
          Security overrides on the Boot 3.3 line: each stays within the version line Boot manages (patch or the
          next compatible Jackson 2.x minor) and is OSV-clean at the time of writing. They fix: Tomcat request
          smuggling via invalid chunk extensions (CVE-2026-24880) and the multipart DoS family; the jackson-core
          number-parsing ReDoS reachable through Double request fields (CVE-2026-89407) and the related 2.17.x
          advisories (no 2.17 fix exists); Netty 4.1 client advisories. Remove an override once the Boot BOM
          manages an equal or newer version. Evidence: docs/security/DEPENDENCY_SECURITY_REVIEW_2026-10.md
        -->
        <tomcat.version>10.1.60</tomcat.version>
        <jackson-bom.version>2.18.11</jackson-bom.version>
        <netty.version>4.1.139.Final</netty.version>
        <!-- Media object storage (S3-compatible): presigned direct-to-storage uploads and object inspection only. -->
        <awssdk.version>2.55.11</awssdk.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>2.6.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          Q5-OBS-1: Micrometer via Actuator, for the consumer limiter/probe measurements Q5-g
          requires before internet exposure. This does NOT open an HTTP surface: web exposure is
          disabled in application.yml, /actuator/** stays UNKNOWN to SurfaceClassifier, and the
          production sink/exporter (CloudWatch vs Prometheus vs OTLP) is a deployment decision
          that is deliberately not made here.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          TR-3 (ratified 2026-09-06, implementation pinned in 5.2.1): the transport sort key is
          NFKC -> trim -> collapse whitespace -> UNICODE CASE-FOLD. Java has no built-in foldCase;
          String.toLowerCase(Locale.ROOT) is a close APPROXIMATION, not the operation the contract
          names, and using it would knowingly implement something weaker than TR-3 says. ICU4J is
          a large artifact, and that cost was accepted with the pick.
        -->
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <version>75.1</version>
        </dependency>
        <!--
          Human admin authentication: Google OIDC ID-token verification. Nimbus JOSE+JWT does the
          JOSE crypto (RS256 signature, kid key selection), the standard claim checks (aud, exp, nbf,
          required claims) and the cached, rate-limited, rotation-aware remote JWKS source. It has
          no Spring Security requirement and verifies against locally generated keys in tests. Not
          managed by the Boot BOM, hence the pinned version. Confined to com.tazzzo.admin.auth by
          ModuleBoundaryTest.
        -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <!-- 9.37.4: bounded JSON nesting (CVE-2025-53864); same 9.37 line, no API change -->
            <version>9.37.4</version>
        </dependency>
        <!--
          CAT-SEC-1 Q5-MECH-1: the consumer limiter is DISTRIBUTED. Two catalogue tasks serve
          consumers concurrently, so per-instance state would make the effective allowance depend
          on the replica count. Shared state is ElastiCache speaking the Redis/Valkey protocol.
          Kept entirely separate from the Mongo connection and config.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
          Media storage: the S3 client (HeadObject, ranged GetObject for magic bytes) and presigner (direct-to-storage
          PUT). The JDK URL-connection HTTP client is used; the SDK's Apache 4, Apache 5 and Netty clients are excluded
          so no extra HTTP stack ships in the image (verified with dependency:build-classpath, no httpclient/httpcore
          jars). The same adapter speaks to S3Mock and CloudServer in tests.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PR-01: module-boundary architecture tests only (test scope). No runtime impact. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
