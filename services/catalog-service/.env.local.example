# Local development environment for a HOST-RUN tazzzo-catalog-service against the
# docker-compose.local.yml stack (DOCKER-LOCAL-1).
#
#   cp .env.local.example .env.local        # .env.local is git-ignored; never commit it
#   set -a; source .env.local; set +a
#   ./mvnw spring-boot:run
#
# EVERY value below is a LOCAL DEVELOPMENT FIXTURE. None of it is production configuration.

# --- MongoDB (the compose stack's single-node replica set) ---
MONGODB_URI='mongodb://localhost:27017/tazzzo?replicaSet=rs0'
MONGODB_DATABASE='tazzzo'

# Background workers off for manual development (merge finalizer, taint, stamp, rollup).
TAZZZO_SCHEDULER_ENABLED='false'

# --- CMS tokens (Q4). Unset disables that role; set only what you need locally. ---
# TAZZZO_CMS_TOKEN='local-cms-token'
# TAZZZO_READ_TOKEN='local-read-token'

# --- Consumer rate limiter (Q5). REDIS mode against the compose stack's Redis. ---
TAZZZO_CONSUMER_RATE_LIMIT_MODE='REDIS'
TAZZZO_RATE_LIMIT_REDIS_URL='redis://localhost:6380'   # host port 6380: 6379 belongs to another project's Redis

# NON-PRODUCTION. Permissive local fixtures so development is never throttled. The production
# Q5 capacities and refill rates are load-derived and mandatory configuration (Q5-c); these
# numbers are NOT candidates for them.
TAZZZO_TRUSTED_PROXY_CIDRS='10.99.99.0/24'
TAZZZO_RATE_LIMIT_IP_CAPACITY='100000'
TAZZZO_RATE_LIMIT_IP_REFILL='100000'
TAZZZO_RATE_LIMIT_INSTALL_CAPACITY='100000'
TAZZZO_RATE_LIMIT_INSTALL_REFILL='100000'

# --- Product-list cursor signing key (LIST-CURSOR-1). ---
# LOCAL SECRET ONLY. Generate a fresh one per machine; never commit it; never reuse it anywhere.
# The production value is generated at deployment setup and is not part of this repository.
#   TAZZZO_CONSUMER_CURSOR_HMAC_KEY_B64="$(openssl rand -base64 32)"
TAZZZO_CONSUMER_CURSOR_HMAC_KEY_B64=''
